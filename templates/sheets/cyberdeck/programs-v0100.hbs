<section class="tab cwnit-cyberdeck__body {{tab.cssClass}}" data-group="primary" data-tab="programs">
  <div class="cwnit-cyberdeck__section-heading"><div><small>Prepared Code Library</small><h2>Programs</h2></div>{{#if editable}}<div><button type="button" data-action="createDoc" data-document-class="Item" data-type="program" data-system.type="verb"><i class="fa-solid fa-plus"></i> Verb</button><button type="button" data-action="createDoc" data-document-class="Item" data-type="program" data-system.type="subject"><i class="fa-solid fa-plus"></i> Subject</button></div>{{/if}}</div>
  <div class="cwnit-cyberdeck__program-columns">
    <section class="cwnit-cyberdeck__panel"><h2>Verbs</h2><ol class="cwnit-cyberdeck__program-list">{{#each cwnit.verbs as |entry|}}<li class="item" data-item-id="{{entry.item.id}}" data-document-class="Item" data-drag="true"><img src="{{entry.item.img}}" alt="" /><div><strong>{{entry.item.name}}</strong><span>{{entry.targets}}</span><small>{{entry.effect}}</small></div><dl><dt>Access</dt><dd>{{entry.accessCost}}</dd><dt>CPU</dt><dd>{{entry.cpuLabel}}</dd></dl><button type="button" data-action="viewDoc"><i class="fa-solid fa-pen-to-square"></i></button>{{#if @root.editable}}<button type="button" data-action="deleteDoc"><i class="fa-solid fa-trash"></i></button>{{/if}}</li>{{else}}<li class="cwnit-cyberdeck__empty">No Verbs loaded.</li>{{/each}}</ol></section>
    <section class="cwnit-cyberdeck__panel"><h2>Subjects</h2><ol class="cwnit-cyberdeck__program-list">{{#each cwnit.subjects as |entry|}}<li class="item" data-item-id="{{entry.item.id}}" data-document-class="Item" data-drag="true"><img src="{{entry.item.img}}" alt="" /><div><strong>{{entry.item.name}}</strong><span>Target: {{entry.target}}</span></div><button type="button" data-action="viewDoc"><i class="fa-solid fa-pen-to-square"></i></button>{{#if @root.editable}}<button type="button" data-action="deleteDoc"><i class="fa-solid fa-trash"></i></button>{{/if}}</li>{{else}}<li class="cwnit-cyberdeck__empty">No Subjects loaded.</li>{{/each}}</ol></section>
  </div>
  <p class="cwnit-cyberdeck__guidance"><i class="fa-solid fa-circle-info"></i> Run network-targeted programs from Network Console. It filters compatible Subjects and remains authoritative for targets, Access, CPU, connection penalties, and GM approval.</p>
</section>
