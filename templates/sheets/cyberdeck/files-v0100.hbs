<section class="tab cwnit-cyberdeck__body {{tab.cssClass}}" data-group="primary" data-tab="files">
  <div class="cwnit-cyberdeck__section-heading"><div><small>Persistent Deck Storage</small><h2>Stored Files</h2></div>{{#if editable}}<button type="button" data-action="createDoc" data-document-class="Item" data-type="program" data-system.type="dataFile"><i class="fa-solid fa-plus"></i> New File</button>{{/if}}</div>
  <p class="cwnit-cyberdeck__guidance">Each native Data File Program Item uses 1 Memory. GM-approved Network Console copies appear here and survive session closure.</p>
  <ol class="cwnit-cyberdeck__file-list">{{#each cwnit.files as |entry|}}<li class="item" data-item-id="{{entry.item.id}}" data-document-class="Item" data-drag="true"><img src="{{entry.item.img}}" alt="" /><div><strong>{{entry.item.name}}</strong><span>{{#if entry.source}}Copied network file{{else}}Local data file{{/if}}</span><small>{{entry.item.system.description}}</small></div><b>Memory {{entry.memory}}</b><button type="button" data-action="viewDoc">Open</button>{{#if @root.editable}}<button type="button" data-action="deleteDoc">Delete</button>{{/if}}</li>{{else}}<li class="cwnit-cyberdeck__empty">No stored files.</li>{{/each}}</ol>
</section>
