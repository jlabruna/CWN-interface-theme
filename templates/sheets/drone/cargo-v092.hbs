<section class="tab cwnit-drone__body {{tab.cssClass}}" data-group="primary" data-tab="cargo">
  <div class="cwnit-drone__section-heading"><div><p>Onboard Logistics</p><h2>Cargo</h2></div>{{#if editable}}<button type="button" data-action="createDoc" data-document-class="Item" data-type="item"><i class="fa-solid fa-plus"></i> New Item</button>{{/if}}</div>
  <p class="cwnit-drone__hint">This is the drone's native carried gear. Drag Items here to add them; weapon and Item mechanics remain controlled by SWNR.</p>
  <ol class="cwnit-drone__cargo-list">
    {{#each cwnit.cargoItems as |cargo|}}
      <li class="item" data-item-id="{{cargo.item._id}}" data-document-class="Item" data-drag="true"><button type="button" data-action="roll" data-roll-type="item"><img src="{{cargo.item.img}}" alt="" /></button><strong>{{cargo.item.name}}</strong><span>{{cargo.item.type}}</span><span>Qty {{cargo.quantity}}</span>{{#if cargo.ammo}}<span class="cwnit-drone__cargo-ammo {{#if cargo.ammo.empty}}is-empty{{/if}}">Rounds {{cargo.ammo.label}}</span>{{else}}<span>Rounds —</span>{{/if}}<span>Enc {{cargo.encumbrance}}</span><div><button type="button" data-action="viewDoc"><i class="fa-solid fa-pen-to-square"></i></button>{{#if @root.editable}}<button type="button" data-action="deleteDoc"><i class="fa-solid fa-trash"></i></button>{{/if}}</div></li>
    {{else}}<li class="cwnit-drone__empty">No cargo carried.</li>{{/each}}
  </ol>
</section>
