<section class="tab cwnit-sheet__body {{tab.cssClass}}" data-group="primary" data-tab="cyberware"><div class="cwnit-sheet__section-heading"><div><p>{{localize "CWNIT.Sheet.Character.SystemsOverline"}}</p><h2>{{localize "CWNIT.Sheet.NPC.Cyberware"}}</h2></div>{{#if cwnit.maintenance}}<button type="button" class="cwnit-sheet__maintenance" data-action="openMaintenance" title="Show Maintenance calculation"><span>Maintenance</span><b>{{cwnit.maintenance.total}}</b></button>{{/if}}</div><div class="cwnit-sheet__native-lists">{{> "systems/swnr/templates/actor/fragments/cyberware-list.hbs" itemList=cwnit.cyberware type="cyberware" name="Cyberware"}}</div><section class="cwnit-sheet__panel"><h2>{{localize "CWNIT.Sheet.NPC.LinkedCyberdecks"}}</h2><ol class="cwnit-sheet__compact-list">{{#each cwnit.linkedCyberdecks as |deck|}}<li><img src="{{deck.img}}" alt="" /><button type="button" data-action="openLinkedActor" data-actor-id="{{deck.id}}">{{deck.name}}</button><small>Direct SWNR link</small></li>{{else}}<li class="cwnit-sheet__empty">{{localize "CWNIT.Sheet.NPC.NoLinkedCyberdecks"}}</li>{{/each}}</ol></section><section class="cwnit-sheet__panel"><h2>Linked Drones</h2><ol class="cwnit-sheet__compact-list">{{#each cwnit.linkedDrones as |drone|}}<li title="World Drone Actor {{drone.id}}"><img src="{{drone.img}}" alt="" /><button type="button" data-action="openLinkedActor" data-actor-id="{{drone.id}}">{{drone.name}}</button><small>{{drone.model}} · {{#if drone.deployed}}Deployed{{else}}Packed{{/if}}</small></li>{{else}}<li class="cwnit-sheet__empty">No linked drones.</li>{{/each}}</ol></section><section class="cwnit-sheet__panel"><h2>Linked Vehicles</h2><ol class="cwnit-sheet__compact-list">{{#each cwnit.linkedVehicles as |vehicle|}}<li title="World Vehicle Actor {{vehicle.id}}"><img src="{{vehicle.img}}" alt="" /><button type="button" data-action="openLinkedActor" data-actor-id="{{vehicle.id}}">{{vehicle.name}}</button><small>Size {{vehicle.size}} · {{#if vehicle.operating}}Operating{{else}}Stationary{{/if}}</small></li>{{else}}<li class="cwnit-sheet__empty">No linked vehicles.</li>{{/each}}</ol></section></section>
