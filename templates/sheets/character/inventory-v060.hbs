<section class="tab cwnit-sheet__body {{tab.cssClass}}" data-group="primary" data-tab="inventory"><div class="cwnit-sheet__section-heading"><div><p>{{localize "CWNIT.Sheet.Character.LogisticsOverline"}}</p><h2>{{localize "CWNIT.Sheet.Character.Inventory"}}</h2></div></div><div class="cwnit-sheet__currency"><label>{{formInput systemFields.credits.fields.carriedBase value=system.credits.carriedBase localize=true}}<span>{{gameSettings.currency.baseCurrencyName}} (Stowed)</span></label><button type="button" data-action="creditChange" data-credit-type="{{gameSettings.currency.baseCurrencyName}}" data-currency-type="base"><i class="fa-solid fa-coins"></i> Change</button><button type="button" data-action="addCurrency"><i class="fa-solid fa-money-bill-wave"></i> Add Currency</button></div><div class="cwnit-sheet__encumbrance"><div><span style="width:{{system.encumbrance.ready.percentage}}%"></span><b>Readied {{system.encumbrance.ready.value}} / {{system.encumbrance.ready.max}}</b></div><div><span style="width:{{system.encumbrance.stowed.percentage}}%"></span><b>Stowed {{system.encumbrance.stowed.value}} / {{system.encumbrance.stowed.max}}</b></div></div><div class="cwnit-sheet__native-lists">{{> "systems/swnr/templates/actor/fragments/items-list.hbs" itemList=actor.itemTypes.weapon type="weapon" name="Weapons"}}{{> "systems/swnr/templates/actor/fragments/consumable-list.hbs" itemList=actor.system.consumables type="item" name="Consumables/Ammo"}}{{> "systems/swnr/templates/actor/fragments/items-list.hbs" itemList=actor.itemTypes.armor type="armor" name="Armor"}}{{> "systems/swnr/templates/actor/fragments/items-list.hbs" itemList=actor.system.gear type="item" name="Items"}}</div>{{#if cwnit.otherItems.length}}<section class="cwnit-sheet__panel"><h2>Other Documents</h2><ol class="cwnit-sheet__compact-list">{{#each cwnit.otherItems as |item|}}<li class="item" data-item-id="{{item._id}}" data-document-class="Item" data-drag="true"><img src="{{item.img}}" alt="" /><button type="button" data-action="viewDoc">{{item.name}}</button><small>{{item.type}}</small></li>{{/each}}</ol></section>{{/if}}</section>
