<section class="tab cwnit-sheet__body cwnit-sheet__biography {{tab.cssClass}}" data-group="primary" data-tab="biography"><div class="cwnit-sheet__section-heading"><div><p>{{localize "CWNIT.Sheet.NPC.IntelOverline"}}</p><h2>{{localize "CWNIT.Sheet.NPC.BiographyAndNotes"}}</h2></div></div><div class="cwnit-sheet__bio-fields"><label>Class<input name="system.class" type="text" value="{{system.class}}" /></label><label>Species<input name="system.species" type="text" value="{{system.species}}" /></label><label>Background<input name="system.background" type="text" value="{{system.background}}" /></label><label>Homeworld<input name="system.homeworld" type="text" value="{{system.homeworld}}" /></label><label>Employer<input name="system.employer" type="text" value="{{system.employer}}" /></label></div><section class="cwnit-sheet__panel languages-section"><h2>Languages</h2>{{#if editable}}{{#if availableLanguages.length}}<button type="button" data-action="toggleLanguageAdd"><i class="fa-solid fa-plus"></i> Add Language</button><div class="language-add-container" id="language-add-section" style="display:none"><select class="language-select" name="language-add-select"><option value="">Select language</option>{{#each availableLanguages as |language|}}{{#unless (includes @root.system.languages language)}}<option value="{{language}}">{{language}}</option>{{/unless}}{{/each}}</select><button type="button" data-action="addLanguage"><i class="fa-solid fa-plus"></i></button></div>{{/if}}{{/if}}<div class="languages-list">{{#each system.languages as |language index|}}<div class="language-item" data-lang-index="{{index}}"><span>{{language}}</span>{{#if @root.editable}}<button type="button" data-action="removeLanguage" data-lang-index="{{index}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</div>{{/each}}</div></section><section class="cwnit-sheet__editor"><h2>Biography</h2>{{#if editable}}<prose-mirror name="system.biography" data-document-u-u-i-d="{{actor.uuid}}" value="{{system.biography}}" collaborate="true" toggled="true">{{{enrichedBiography}}}</prose-mirror>{{else}}<div class="editor-content">{{{enrichedBiography}}}</div>{{/if}}</section><section class="cwnit-sheet__panel"><h2>Goals</h2><textarea name="system.goals">{{system.goals}}</textarea></section></section>
