<section class="tab cwnit-sheet__body {{tab.cssClass}}" data-group="primary" data-tab="cyberware"><div class="cwnit-sheet__section-heading"><div><p>{{localize "CWNIT.Sheet.Character.SystemsOverline"}}</p><h2>{{localize "CWNIT.Sheet.NPC.Cyberware"}}</h2></div></div><div class="cwnit-sheet__native-lists">{{> "systems/swnr/templates/actor/fragments/cyberware-list.hbs" itemList=cwnit.cyberware type="cyberware" name="Cyberware"}}</div><section class="cwnit-sheet__panel"><h2>{{localize "CWNIT.Sheet.NPC.LinkedCyberdecks"}}</h2><ol class="cwnit-sheet__compact-list">{{#each cwnit.linkedCyberdecks as |deck|}}<li><img src="{{deck.img}}" alt="" /><button type="button" data-action="openLinkedActor" data-actor-id="{{deck.id}}">{{deck.name}}</button><small>Direct SWNR link</small></li>{{else}}<li class="cwnit-sheet__empty">{{localize "CWNIT.Sheet.NPC.NoLinkedCyberdecks"}}</li>{{/each}}</ol></section></section>
