<section class="tab cwnit-sheet__body {{tab.cssClass}}" data-group="primary" data-tab="actions"><div class="cwnit-sheet__section-heading"><div><p>{{localize "CWNIT.Sheet.Character.ActionOverline"}}</p><h2>{{localize "CWNIT.Sheet.Character.Actions"}}</h2></div></div><section class="cwnit-sheet__action-centre-panel"><div><i class="fa-solid fa-bolt"></i><h3>{{localize "CWNIT.Sheet.Character.YourActions"}}</h3><p>{{localize "CWNIT.Sheet.Character.ActionCentreCanonical"}}</p></div>{{#if cwnit.hasActionCentre}}<button type="button" data-action="openActionCentre">{{localize "CWNIT.Sheet.Character.OpenActionCentre"}}</button>{{else}}<span>{{localize "CWNIT.Sheet.Character.NoActionCentre"}}</span>{{/if}}</section><div class="cwnit-sheet__action-grid">{{#each cwnit.actionReferences as |action|}}<article><header><h3>{{action.name}}</h3><small>Reference / declaration</small></header><b>{{action.cost}}</b><p>{{action.summary}}</p><button type="button" data-action="declareAction" data-action-key="{{action.key}}"><i class="fa-solid fa-bullhorn"></i> Declare in Chat</button></article>{{/each}}</div><section class="cwnit-sheet__panel"><h2>{{localize "CWNIT.Sheet.Character.QuickActions"}}</h2><div class="cwnit-sheet__quick-actions"><button type="button" data-action="rollInitiative">Initiative</button><button type="button" data-action="rollSave" data-save-type="physical">Physical Save</button><button type="button" data-action="rollSave" data-save-type="evasion">Evasion Save</button><button type="button" data-action="rollSave" data-save-type="mental">Mental Save</button><button type="button" data-action="rollSave" data-save-type="luck">Luck Save</button></div></section></section>
