<section class="tab cwnit-sheet__body {{tab.cssClass}}" data-group="primary" data-tab="skills"><div class="cwnit-sheet__section-heading"><div><p>{{localize "CWNIT.Sheet.Character.TrainingOverline"}}</p><h2>{{localize "CWNIT.Sheet.Character.Skills"}}</h2></div>{{#if editable}}<button type="button" data-action="createDoc" data-document-class="Item" data-type="skill"><i class="fa-solid fa-plus"></i> New Skill</button>{{/if}}</div><ol class="cwnit-sheet__skill-list">{{#each cwnit.skills as |skill|}}<li class="item" data-item-id="{{skill._id}}" data-document-class="Item" data-drag="true"><button type="button" class="cwnit-sheet__skill-roll" data-action="rollSkill"><img src="{{skill.img}}" alt="" /><span>{{skill.name}}</span><b>{{skill.system.rank}}</b></button><div>{{#if @root.editable}}<button type="button" data-action="skillUp" data-item-id="{{skill._id}}"><i class="fa-solid fa-arrow-up"></i></button>{{/if}}<button type="button" data-action="viewDoc"><i class="fa-solid fa-pen-to-square"></i></button>{{#if @root.editable}}<button type="button" data-action="deleteDoc"><i class="fa-solid fa-trash"></i></button>{{/if}}</div></li>{{else}}<li class="cwnit-sheet__empty"><button type="button" data-action="loadSkills">Load SWNR skills</button></li>{{/each}}</ol><div class="cwnit-sheet__points"><label>Unspent Skill Points <input name="system.unspentSkillPoints" type="number" value="{{system.unspentSkillPoints}}" /></label><label>Unspent Psychic Skill Points <input name="system.unspentPsySkillPoints" type="number" value="{{system.unspentPsySkillPoints}}" /></label></div></section>
