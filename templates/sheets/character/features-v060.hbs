<section class="tab cwnit-sheet__body {{tab.cssClass}}" data-group="primary" data-tab="features"><div class="cwnit-sheet__section-heading"><div><p>{{localize "CWNIT.Sheet.Character.CapabilitiesOverline"}}</p><h2>{{localize "CWNIT.Sheet.NPC.FeaturesAndPowers"}}</h2></div></div><div class="cwnit-sheet__feature-columns"><section class="cwnit-sheet__panel"><h2>{{localize "CWNIT.Sheet.NPC.Features"}}</h2><ol class="cwnit-sheet__compact-list">{{#each cwnit.features as |item|}}<li class="item" data-item-id="{{item._id}}" data-document-class="Item" data-drag="true"><img src="{{item.img}}" alt="" /><button type="button" data-action="viewDoc">{{item.name}}</button><small>{{item.system.type}} {{item.system.level}}</small>{{#if @root.editable}}<button type="button" data-action="deleteDoc"><i class="fa-solid fa-trash"></i></button>{{/if}}</li>{{else}}<li class="cwnit-sheet__empty">{{localize "CWNIT.Sheet.NPC.NoFeatures"}}</li>{{/each}}</ol></section><section class="cwnit-sheet__panel"><h2>{{localize "CWNIT.Sheet.NPC.Powers"}}</h2><ol class="cwnit-sheet__compact-list">{{#each cwnit.powers as |power|}}<li class="item" data-item-id="{{power.item._id}}" data-document-class="Item" data-drag="true"><img src="{{power.item.img}}" alt="" /><button type="button" data-action="roll" data-roll-type="item">{{power.item.name}}</button><small>{{power.subType}} {{power.level}}</small></li>{{else}}<li class="cwnit-sheet__empty">{{localize "CWNIT.Sheet.NPC.NoPowers"}}</li>{{/each}}</ol></section></div><section class="cwnit-sheet__panel"><h2>{{localize "CWNIT.Sheet.NPC.StatusEffects"}}</h2><ol class="cwnit-sheet__compact-list">{{#each cwnit.effects as |effect|}}<li data-effect-id="{{effect.id}}" data-document-class="ActiveEffect"><img src="{{effect.img}}" alt="" /><span>{{effect.name}}</span><button type="button" data-action="toggleEffect"><i class="fa-solid fa-eye"></i></button>{{#if @root.editable}}<button type="button" data-action="deleteDoc"><i class="fa-solid fa-trash"></i></button>{{/if}}</li>{{else}}<li class="cwnit-sheet__empty">{{localize "CWNIT.Sheet.NPC.NoEffects"}}</li>{{/each}}</ol></section></section>
