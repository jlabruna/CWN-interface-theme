<section class="tab cwnit-sheet__body {{tab.cssClass}}" data-group="primary" data-tab="combat">
  <div class="cwnit-sheet__section-heading">
    <div>
      <p>{{localize "CWNIT.Sheet.Character.CombatOverline"}}</p>
      <h2>{{localize "CWNIT.Sheet.Character.Weapons"}}</h2>
    </div>
  </div>

  <ol class="cwnit-sheet__attack-grid">
    {{#each cwnit.weapons as |attack|}}
      <li class="cwnit-sheet__attack item" data-item-id="{{attack.item._id}}" data-document-class="Item" data-drag="true">
        <div class="cwnit-sheet__attack-title">
          <button type="button" class="cwnit-sheet__item-icon" data-action="viewDoc"><img src="{{attack.item.img}}" alt="" /></button>
          <div><h3>{{attack.item.name}}</h3><span>{{attack.classification}} · {{attack.mode}}</span></div>
          <button type="button" class="cwnit-sheet__icon-button" data-action="viewDoc"><i class="fa-solid fa-pen-to-square"></i></button>
        </div>
        <dl class="cwnit-sheet__attack-stats">
          <div><dt>{{localize "CWNIT.Sheet.NPC.Damage"}}</dt><dd>{{attack.damage}}</dd></div>
          <div><dt>{{localize "CWNIT.Sheet.NPC.AttackBonus"}}</dt><dd>{{attack.actorAttackBonus}} + {{attack.weaponAttackBonus}}</dd></div>
          <div><dt>{{localize "CWNIT.Sheet.NPC.Ammo"}}</dt><dd>{{attack.ammo}}</dd></div>
          <div><dt>{{localize "CWNIT.Sheet.NPC.Range"}}</dt><dd>{{attack.range}}</dd></div>
          <div><dt>{{localize "CWNIT.Sheet.NPC.Shock"}}</dt><dd>{{attack.shock}}</dd></div>
          <div><dt>{{localize "CWNIT.Sheet.NPC.Trauma"}}</dt><dd>{{attack.trauma}}</dd></div>
        </dl>
        <div class="cwnit-sheet__attack-actions">
          <button type="button" data-action="roll" data-roll-type="item"><i class="fa-solid fa-crosshairs"></i> {{localize "CWNIT.Sheet.NPC.Attack"}}</button>
          {{#if attack.canReload}}<button type="button" data-action="reload"><i class="fa-solid fa-arrows-rotate"></i> {{localize "CWNIT.Sheet.NPC.Reload"}}</button>{{/if}}
        </div>
      </li>
    {{else}}
      <li class="cwnit-sheet__empty">{{localize "CWNIT.Sheet.Character.NoWeapons"}}</li>
    {{/each}}
  </ol>

  <div class="cwnit-sheet__combat-columns cwnit-sheet__combat-columns--actions">
    <section class="cwnit-sheet__panel">
      <h2>Quick Saves</h2>
      <div class="cwnit-sheet__quick-actions">
        <button type="button" data-action="rollSave" data-save-type="physical"><i class="fa-solid fa-shield"></i> Physical {{system.save.physical}}+</button>
        <button type="button" data-action="rollSave" data-save-type="evasion"><i class="fa-solid fa-person-running"></i> Evasion {{system.save.evasion}}+</button>
        <button type="button" data-action="rollSave" data-save-type="mental"><i class="fa-solid fa-brain"></i> Mental {{system.save.mental}}+</button>
        <button type="button" data-action="rollSave" data-save-type="luck"><i class="fa-solid fa-clover"></i> Luck {{system.save.luck}}+</button>
      </div>
    </section>
    <section class="cwnit-sheet__panel cwnit-sheet__tactical-actions">
      <h2>{{localize "CWNIT.Sheet.Character.YourActions"}}</h2>
      <p class="cwnit-sheet__panel-note">Tracked Edge and Focus abilities are available from the Action Centre in the dossier header.</p>
      <div class="cwnit-sheet__reference-actions">
        <button type="button" data-action="declareAction" data-action-key="total-defense">Total Defense</button>
        <button type="button" data-action="declareAction" data-action-key="fighting-withdrawal">Fighting Withdrawal</button>
        <button type="button" data-action="declareAction" data-action-key="hold-action">Hold an Action</button>
        <button type="button" data-action="openActionsTab"><i class="fa-solid fa-ellipsis"></i> More Actions</button>
      </div>
    </section>
  </div>
</section>
