<header class="cwnit-sheet--npc__header">
  <button class="cwnit-sheet--npc__portrait" type="button" data-action="onEditImage" data-edit="img" title="{{localize 'CWNIT.Sheet.NPC.EditPortrait'}}">
    <img src="{{actor.img}}" alt="{{actor.name}}" />
  </button>
  <div class="cwnit-sheet--npc__identity">
    <p class="cwnit-sheet--npc__eyebrow">{{localize 'CWNIT.Sheet.NPC.Eyebrow'}}</p>
    <input class="cwnit-sheet--npc__name" name="name" type="text" value="{{actor.name}}" aria-label="{{localize 'Name'}}" />
    <div class="cwnit-sheet--npc__identity-grid">
      <label><span>{{localize 'CWNIT.Sheet.NPC.Species'}}</span><input name="system.species" type="text" value="{{system.species}}" /></label>
      <label><span>{{localize 'CWNIT.Sheet.NPC.Faction'}}</span><input name="system.faction" type="text" value="{{system.faction}}" /></label>
      <label><span>{{localize 'CWNIT.Sheet.NPC.Homeworld'}}</span><input name="system.homeworld" type="text" value="{{system.homeworld}}" /></label>
    </div>
  </div>
  <div class="cwnit-sheet--npc__header-actions">
    {{#if cwnit.hasActionCentre}}
      <button type="button" data-action="openActionCentre" title="{{localize 'CWNIT.Sheet.NPC.ActionCentreHint'}}">
        <i class="fa-solid fa-bolt" aria-hidden="true"></i><span>{{localize 'CWNIT.Sheet.NPC.ActionCentre'}}</span>
      </button>
    {{/if}}
    <button type="button" data-action="rollInitiative"><i class="fa-solid fa-forward-fast" aria-hidden="true"></i><span>{{localize 'CWNIT.Sheet.NPC.Initiative'}}</span></button>
    <button type="button" data-action="moraleRoll" data-target="{{system.moralScore}}"><i class="fa-solid fa-dice" aria-hidden="true"></i><span>{{localize 'CWNIT.Sheet.NPC.Morale'}}</span></button>
  </div>
</header>
<section class="cwnit-sheet--npc__vitals" aria-label="{{localize 'CWNIT.Sheet.NPC.Vitals'}}">
  <label class="cwnit-sheet--npc__hp"><span>HP</span><input name="system.health.value" type="number" value="{{system.health.value}}" /><b>/</b><input name="system.health.max" type="number" value="{{system.health.max}}" /></label>
  <div><span>AC</span><strong>{{system.ac}}</strong></div>
  <div><span>{{localize 'CWNIT.Sheet.NPC.MeleeAC'}}</span><strong>{{system.meleeAc}}</strong></div>
  {{#if gameSettings.useCWNArmor}}<div><span>{{localize 'CWNIT.Sheet.NPC.Soak'}}</span><strong>{{system.soakTotal.value}} / {{system.soakTotal.max}}</strong></div>{{/if}}
  {{#if gameSettings.useTrauma}}<div><span>{{localize 'CWNIT.Sheet.NPC.TraumaTarget'}}</span><strong>{{system.modifiedTraumaTarget}}</strong></div>{{/if}}
  <div><span>{{localize 'CWNIT.Sheet.NPC.Movement'}}</span><strong>{{system.speed}}</strong></div>
</section>
