<section class="tab cwnit-drone__body {{tab.cssClass}}" data-group="primary" data-tab="configuration">
  <div class="cwnit-drone__section-heading"><div><p>WORKSHOP ACCESS</p><h2>Configuration</h2></div></div>
  <p class="cwnit-drone__hint">Native SWNR fields remain authoritative. Power, Mass, hardpoint, and other modifiers should be applied through SWNR Items and Active Effects; this sheet does not maintain a second rules chain.</p>
  <dl class="cwnit-drone__configuration-summary"><div><dt>Base AC</dt><dd>{{cwnit.baseAc}}</dd></div><div><dt>Effective AC</dt><dd>{{cwnit.ac.effective}}</dd></div><div><dt>Size</dt><dd>{{system.size}}</dd></div><div><dt>Tech Level</dt><dd>{{system.tl}}</dd></div><div><dt>Cost</dt><dd>{{system.cost}}</dd></div><div><dt>Power</dt><dd>{{cwnit.powerUsage.used}} / {{cwnit.powerUsage.maximum}}</dd></div><div><dt>Mass</dt><dd>{{cwnit.massUsage.used}} / {{cwnit.massUsage.maximum}}</dd></div><div><dt>Hardpoints</dt><dd>{{cwnit.hardpointUsage.used}} / {{cwnit.hardpointUsage.maximum}}</dd></div><div><dt>Cargo</dt><dd>{{cwnit.cargoUsage.used}} / {{cwnit.cargoUsage.maximum}}</dd></div></dl>
  {{#if cwnit.canConfigureAdvanced}}<details class="cwnit-drone__advanced"><summary><i class="fa-solid fa-screwdriver-wrench"></i> Advanced Configuration</summary><div class="cwnit-drone__config-grid">
    <label><span>Base Armor Class</span><input name="system.ac" type="number" value="{{cwnit.baseAc}}" /></label><label><span>Trauma Target</span><input name="system.traumaTarget" type="number" value="{{system.traumaTarget}}" /></label><label><span>Armor Current</span><input name="system.armor.value" type="number" value="{{system.armor.value}}" /></label><label><span>Armor Maximum</span><input name="system.armor.max" type="number" value="{{system.armor.max}}" /></label>
    <label><span>Vehicle Size</span>{{formInput systemFields.size value=system.size localize=true}}</label><label><span>Tech Level</span><input name="system.tl" type="number" value="{{system.tl}}" /></label><label><span>Cost</span><input name="system.cost" type="number" value="{{system.cost}}" /></label><label><span>Speed</span><input name="system.speed" type="number" value="{{system.speed}}" /></label><label><span>KPH</span><input name="system.kmph" type="number" value="{{system.kmph}}" /></label><label><span>Tonnage</span><input name="system.tonnage" type="number" value="{{system.tonnage}}" /></label>
    <label><span>Power Capacity</span><input name="system.power.max" type="number" value="{{system.power.max}}" /></label><label><span>Mass Capacity</span><input name="system.mass.max" type="number" value="{{system.mass.max}}" /></label><label><span>Hardpoints</span><input name="system.hardpoints.max" type="number" value="{{system.hardpoints.max}}" /></label><label><span>Cargo Capacity</span><input name="system.cargo.max" type="number" value="{{system.cargo.max}}" /></label><label><span>Minimum Crew</span><input name="system.crew.min" type="number" value="{{system.crew.min}}" /></label><label><span>Maximum Crew</span><input name="system.crew.max" type="number" value="{{system.crew.max}}" /></label><label><span>Fuel Needed</span><input name="system.fuelNeeded" type="number" value="{{system.fuelNeeded}}" /></label><label><span>Run Hours Current</span><input name="system.runHours.value" type="number" value="{{system.runHours.value}}" /></label><label><span>Run Hours Maximum</span><input name="system.runHours.max" type="number" value="{{system.runHours.max}}" /></label>
  </div></details>{{/if}}
  <div class="cwnit-drone__section-heading cwnit-drone__subheading"><div><p>ACTOR &amp; ITEM EFFECTS</p><h2>Effects</h2></div>{{#if cwnit.canConfigureAdvanced}}<button type="button" data-action="createDoc" data-document-class="ActiveEffect" data-origin="{{actor.uuid}}" data-img="icons/svg/aura.svg"><i class="fa-solid fa-plus"></i> Add Effect</button>{{/if}}</div>
  <ol class="cwnit-drone__effect-list">{{#each cwnit.effects as |entry|}}<li class="effect" data-effect-id="{{entry.effect.id}}" data-parent-id="{{entry.parentId}}" data-document-class="ActiveEffect" data-drag="true"><img src="{{entry.effect.img}}" alt="" /><strong>{{entry.effect.name}}</strong><span>{{entry.source}}</span><span>{{entry.duration}}</span><div>{{#if @root.cwnit.canConfigureAdvanced}}<button type="button" data-action="toggleEffect"><i class="fa-solid {{#if entry.effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></button>{{/if}}<button type="button" data-action="viewDoc"><i class="fa-solid fa-eye"></i></button>{{#if @root.cwnit.canConfigureAdvanced}}<button type="button" data-action="deleteDoc"><i class="fa-solid fa-trash"></i></button>{{/if}}</div></li>{{else}}<li class="cwnit-drone__empty">No effects are currently present.</li>{{/each}}</ol>
</section>
