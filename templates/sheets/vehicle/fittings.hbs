<section class="tab cwnit-drone__body {{tab.cssClass}}" data-group="primary" data-tab="fittings">
  <div class="cwnit-drone__section-heading"><div><p>VEHICLE CAPACITY</p><h2>Fittings &amp; Systems</h2></div><div class="cwnit-drone__capacity-badges"><span class="{{#if cwnit.powerUsage.over}}is-over-capacity{{/if}}">Power {{cwnit.powerUsage.used}} / {{cwnit.powerUsage.maximum}}</span><span class="{{#if cwnit.massUsage.over}}is-over-capacity{{/if}}">Mass {{cwnit.massUsage.used}} / {{cwnit.massUsage.maximum}}</span><span class="{{#if cwnit.hardpointUsage.over}}is-over-capacity{{/if}}">Hardpoints {{cwnit.hardpointUsage.used}} / {{cwnit.hardpointUsage.maximum}}</span></div></div>
  <p class="cwnit-drone__hint">Power, Mass, hardpoints, and minimum Vehicle size are checked before Items are created or dropped. A GM may confirm an intentional custom override.</p>
  <ol class="cwnit-drone__fitting-list">{{#each cwnit.fittings as |entry|}}<li class="item" data-item-id="{{entry.item.id}}" data-document-class="Item" data-drag="true"><img src="{{entry.item.img}}" alt="" /><div><header><h3>{{entry.item.name}}</h3><span>{{entry.power}} power · {{entry.mass}} mass · min {{entry.minClass}}</span></header><p>{{entry.summary}}</p></div><div class="cwnit-drone__item-controls"><button type="button" data-action="viewDoc" data-item-id="{{entry.item.id}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></button>{{#if @root.cwnit.canManage}}<button type="button" data-action="deleteDoc" data-item-id="{{entry.item.id}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</div></li>{{else}}<li class="cwnit-drone__empty">No fittings installed.</li>{{/each}}</ol>
  {{#if cwnit.canManage}}<button type="button" data-action="createDoc" data-document-class="Item" data-type="shipFitting" data-system.type="vehicle" data-system.min-class="s"><i class="fa-solid fa-plus"></i> New Fitting</button>{{/if}}
  <div class="cwnit-drone__section-heading cwnit-drone__subheading"><div><p>DEFENSIVE SYSTEMS</p><h2>Defenses</h2></div></div>
  <ol class="cwnit-drone__fitting-list">{{#each cwnit.defenses as |entry|}}<li class="item" data-item-id="{{entry.item.id}}" data-document-class="Item" data-drag="true"><img src="{{entry.item.img}}" alt="" /><div><header><h3>{{entry.item.name}}</h3><span>{{entry.power}} power · {{entry.mass}} mass · min {{entry.minClass}}</span></header><p>{{entry.summary}}</p></div><div class="cwnit-drone__item-controls"><button type="button" data-action="viewDoc" data-item-id="{{entry.item.id}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></button>{{#if @root.cwnit.canManage}}<button type="button" data-action="deleteDoc" data-item-id="{{entry.item.id}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</div></li>{{else}}<li class="cwnit-drone__empty">No defensive systems installed.</li>{{/each}}</ol>
  {{#if cwnit.canManage}}<button type="button" data-action="createDoc" data-document-class="Item" data-type="shipDefense" data-system.type="vehicle" data-system.min-class="s"><i class="fa-solid fa-plus"></i> New Defense</button>{{/if}}
</section>
