<section class="tab cwnit-drone__body {{tab.cssClass}}" data-group="primary" data-tab="cargo">
  <div class="cwnit-drone__section-heading"><div><p>LOGISTICS</p><h2>Cargo</h2></div><div class="cwnit-drone__capacity-badges"><span>Cargo {{cwnit.cargoUsage.used}} / {{cwnit.cargoUsage.maximum}}</span></div>{{#if cwnit.canManage}}<button type="button" data-action="createDoc" data-document-class="Item" data-type="item"><i class="fa-solid fa-plus"></i> New Item</button>{{/if}}</div>
  <ol class="cwnit-drone__cargo-list">{{#each cwnit.cargoItems as |cargo|}}<li class="item" data-item-id="{{cargo.item.id}}" data-document-class="Item" data-drag="true"><img src="{{cargo.item.img}}" alt="" /><strong>{{cargo.item.name}}</strong><span>{{cargo.item.type}}</span><span>Qty {{cargo.quantity}}</span><span>{{cargo.location}}</span><span>Enc {{cargo.encumbrance}}</span><div><button type="button" data-action="viewDoc" data-item-id="{{cargo.item.id}}"><i class="fa-solid fa-pen-to-square"></i></button>{{#if @root.cwnit.canManage}}<button type="button" data-action="deleteDoc" data-item-id="{{cargo.item.id}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</div></li>{{else}}<li class="cwnit-drone__empty">No carried gear.</li>{{/each}}</ol>
  <div class="cwnit-drone__section-heading cwnit-drone__subheading"><div><p>BULK LOADS</p><h2>Cargo Resources</h2></div>{{#if cwnit.canManage}}<button type="button" data-action="resourceCreate"><i class="fa-solid fa-plus"></i> New Cargo Resource</button>{{/if}}</div>
  <ol class="cwnit-vehicle__resources">{{#each cwnit.cargoResources as |resource|}}<li><input class="resource-list-val" data-rl-idx="{{resource.index}}" data-rl-type="name" value="{{resource.name}}" {{#unless @root.cwnit.canManage}}disabled{{/unless}} /><input class="resource-list-val" type="number" data-rl-idx="{{resource.index}}" data-rl-type="value" value="{{resource.value}}" {{#unless @root.cwnit.canManage}}disabled{{/unless}} /><span>/</span><input class="resource-list-val" type="number" data-rl-idx="{{resource.index}}" data-rl-type="max" value="{{resource.max}}" {{#unless @root.cwnit.canManage}}disabled{{/unless}} />{{#if @root.cwnit.canManage}}<button type="button" data-action="resourceDelete" data-idx="{{resource.index}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</li>{{else}}<li class="cwnit-drone__empty">No cargo resources recorded.</li>{{/each}}</ol>
</section>
