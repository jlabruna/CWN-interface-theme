<section class="tab cwnit-drone__body {{tab.cssClass}}" data-group="primary" data-tab="weapons">
  <div class="cwnit-drone__section-heading"><div><p>ARMAMENT DETAIL</p><h2>Mounted Weapons</h2></div>{{#if cwnit.canManage}}<button type="button" data-action="mountExistingWeapon"><i class="fa-solid fa-screwdriver-wrench"></i> Mount Existing Weapon</button><button type="button" data-action="createDoc" data-document-class="Item" data-type="shipWeapon" data-system.type="vehicle" data-system.min-class="s"><i class="fa-solid fa-plus"></i> New Mounted Weapon</button>{{/if}}</div>
  <p class="cwnit-drone__hint">Ordinary SWNR Weapons are carried Cargo. Use <strong>Mount Existing Weapon</strong> to convert one into a native mounted weapon while preserving its combat and ammunition data. Every mounted weapon has one persistent Gunner.</p>
  <ol class="cwnit-drone__fitting-list">
    {{#each cwnit.mountedWeapons as |weapon|}}
      <li class="item" data-item-id="{{weapon.item.id}}" data-document-class="Item" data-drag="true"><img src="{{weapon.item.img}}" alt="" /><div><header><h3>{{weapon.item.name}}</h3><span>{{weapon.power}} power · {{weapon.mass}} mass · {{weapon.hardpoints}} HP · min {{weapon.minClass}}</span></header><p>Damage {{weapon.damage}} · AB {{weapon.attackBonus}} · {{weapon.stat}} · Range {{weapon.range}} · Ammo {{weapon.ammo}} · Trauma {{weapon.trauma}}</p><p>{{#if weapon.gunner}}Gunner: <strong>{{weapon.gunner.name}}</strong>{{else}}<strong class="is-missing">No gunner assigned</strong>{{/if}}</p></div><div class="cwnit-drone__item-controls"><button type="button" data-action="viewDoc" data-item-id="{{weapon.item.id}}" title="Edit Mounted Weapon"><i class="fa-solid fa-pen-to-square"></i></button>{{#if weapon.canManage}}<button type="button" data-action="assignGunner" data-item-id="{{weapon.item.id}}" title="{{#if weapon.gunner}}Change Gunner{{else}}Assign Gunner{{/if}}"><i class="fa-solid {{#if weapon.gunner}}fa-repeat{{else}}fa-user-plus{{/if}}"></i></button>{{#if weapon.gunner}}<button type="button" data-action="unlinkGunner" data-item-id="{{weapon.item.id}}" title="Clear Gunner"><i class="fa-solid fa-link-slash"></i></button>{{/if}}<button type="button" data-action="deleteDoc" data-item-id="{{weapon.item.id}}" title="Delete Mounted Weapon"><i class="fa-solid fa-trash"></i></button>{{/if}}</div></li>
    {{else}}<li class="cwnit-drone__empty">No mounted weapons installed.</li>{{/each}}
  </ol>
</section>
